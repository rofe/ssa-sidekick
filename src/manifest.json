{
  "manifest_version": 3,
  "name": "AEM Sidekick SSA Add-On",
  "version": "0.0.1",
  "author": "Adobe",
  "homepage_url": "https://www.aem.live/docs/sidekick",
  "description": "Add-On for using AEM Sidekick in a Single Souvereign Architecture (SSA) environment",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ssa_ruleset",
        "enabled": true,
        "path": "ruleset.json"
      }
    ]
  },
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/default/icon-16x16.png",
    "32": "icons/default/icon-32x32.png",
    "48": "icons/default/icon-48x48.png",
    "128": "icons/default/icon-128x128.png",
    "512": "icons/default/icon-512x512.png"
  }
}
